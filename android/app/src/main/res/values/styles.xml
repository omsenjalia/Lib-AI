<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when
         the app is first launched. Library AI is dark-mode-first, so the launch
         window uses the dark charcoal base rather than white - this is what
         stops the blank-flash between tapping the icon and the first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/library_launch_background</item>
        <item name="android:navigationBarColor">@color/library_launch_background</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/library_launch_background</item>
        <item name="android:statusBarColor">@color/library_launch_background</item>
        <item name="android:navigationBarColor">@color/library_launch_background</item>
    </style>
</resources>
