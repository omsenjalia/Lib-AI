# Dart / Flutter
.dart_tool/
.packages
.pub/
build/
.flutter-plugins
.flutter-plugins-dependencies
*.log

# IDE
.idea/
.vscode/
*.iml

# Secrets and signing - never commit these.
.env
*.keystore
*.jks
key.properties
**/android/key.properties
**/android/local.properties
google-services.json

# Android build output
android/.gradle/
android/app/.cxx/
android/local.properties

# CI analyzer artifacts (mirrors WeatherGPT)
analyze.txt
analyze-comment.md
test-output.txt
test-comment.md

# Downloaded GGUF models must never enter git.
*.gguf
/models/

# Generated code. drift's database.g.dart is produced by build_runner, which
# every workflow runs before analyze/test; leaving it untracked-but-not-ignored
# made it show up as a dirty file after any local build.
*.g.dart

# Python bytecode from tooling (the catalogue generator is run in place)
__pycache__/
*.pyc
